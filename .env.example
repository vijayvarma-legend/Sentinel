# Copy to .env for local development. Never commit .env.
# Host ports are deliberately non-default. This machine already runs a local PostgreSQL 17
# and a separate 'kinnred' project on 5433/6380/9000-9001; Sentinel stays clear of both.

SENTINEL_ENV=local

# --- PostgreSQL (docker-compose) ---
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev@localhost:5434/sentinel

# --- Redis (docker-compose) ---
SENTINEL_REDIS_URL=redis://localhost:6381/0

# --- Object storage: MinIO locally, S3 in production (ADR-0006) ---
SENTINEL_S3_ENDPOINT_URL=http://localhost:9010
SENTINEL_S3_ACCESS_KEY=sentinel
SENTINEL_S3_SECRET_KEY=sentinel_dev_secret
SENTINEL_S3_BUCKET=sentinel-documents
SENTINEL_S3_REGION=us-east-1

# --- Vision extraction (Phase 2, Q-1 still open -- ADR-0006) ---
# SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_EXTRACTION_PROVIDER=fixture
SENTINEL_EXTRACTION_MIN_CONFIDENCE=0.80

# --- Ingestion limits ---
SENTINEL_MAX_DOCUMENT_BYTES=26214400
